<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.bwton.framework</groupId>
        <artifactId>urobot-sdk-example</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>backend</artifactId>

    <properties>
        <urobot-sdk.version>4.1.0</urobot-sdk.version>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    </properties>

    <!-- 强制统一 SLF4J 版本为 1.7.36，兼容 Spring Boot 2.7 的 logback 1.2.x -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>1.7.36</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <dependency>
            <groupId>io.github.bwtrobot</groupId>
            <artifactId>urobot-opensdk-core</artifactId>
            <version>${urobot-sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bwtrobot</groupId>
            <artifactId>urobot-opensdk-services</artifactId>
            <version>${urobot-sdk.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bwtrobot</groupId>
            <artifactId>urobot-opensdk-ws</artifactId>
            <version>${urobot-sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>org.yaml </groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.6</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <version>2.7.18</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>2.7.18</version>
            <scope>test</scope>
        </dependency>

    </dependencies>
</project>
